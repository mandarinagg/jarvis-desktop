{
  "name": "@jarvis/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./token": {
      "types": "./dist/token.d.ts",
      "default": "./dist/token.js"
    },
    "./main": "./dist/main.js"
  },
  "bin": {
    "jarvis-core": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@jarvis/shared": "workspace:*",
    "@napi-rs/keyring": "2.1.2"
  }
}
